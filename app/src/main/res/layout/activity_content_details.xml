<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="288dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cf_item"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/detail_icon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_cf_icon"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_minecraft_cube" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/misans"
                        android:maxLines="2"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Furnicraft Addon" />

                    <TextView
                        android:id="@+id/detail_author"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/misans"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="by RobertGamer69" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detail_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/stat_downloads_format"
                        android:src="@drawable/ic_download"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/stat_downloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="2.2M downloads" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stat_likes_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/stat_likes_format"
                        android:src="@drawable/ic_star" />

                    <TextView
                        android:id="@+id/stat_likes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="5.3K likes" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stat_updated_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@string/stat_updated_format"
                        android:src="@drawable/ic_clock" />

                    <TextView
                        android:id="@+id/stat_updated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="Updated 2026-11-06" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/detail_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/misans"
                android:textColor="@color/on_surface"
                android:textSize="12sp"
                tools:text="Armor, Tools, and Weapons · Survival · Mobs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_install_header"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/install"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/misans"
                android:backgroundTint="@color/primary"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_download"
                app:iconPadding="5dp"
                app:iconSize="16dp"
                app:iconTint="@color/on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_browser"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/website"
                android:textAllCaps="false"
                android:textColor="@color/on_surface"
                android:textSize="12sp"
                android:fontFamily="@font/misans"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_internet"
                app:iconPadding="5dp"
                app:iconSize="16dp"
                app:iconTint="@color/on_surface"
                app:strokeColor="@color/divider" />

            <ProgressBar
                android:id="@+id/download_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="7dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cf_item"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <RadioGroup
                        android:id="@+id/detail_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="7dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/tab_description"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_filter_chip"
                            android:button="@null"
                            android:checked="true"
                            android:fontFamily="@font/misans"
                            android:gravity="center"
                            android:text="@string/description"
                            android:textColor="@color/color_filter_chip_text"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/tab_gallery"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_filter_chip"
                            android:button="@null"
                            android:fontFamily="@font/misans"
                            android:gravity="center"
                            android:text="@string/gallery"
                            android:textColor="@color/color_filter_chip_text"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <WebView
                        android:id="@+id/detail_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent" />

                    <LinearLayout
                        android:id="@+id/gallery_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/gallery_recycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:overScrollMode="never" />

                        <TextView
                            android:id="@+id/gallery_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/misans"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="@string/no_screenshots"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
